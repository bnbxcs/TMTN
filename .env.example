# 复制成 .env 后按需修改。程序启动时会自动读取项目根目录的 .env（已经在环境变量里的不覆盖）

# sim = 模拟盘；live = 实盘行情
MODE=sim
PORT=8787

# 1 = 实盘真实下单（只接受页面上手动点击的订单）；0 = 只报价 / 预演
LIVE_TRADE=0

# 单笔买入上限（BNB），0 = 不限；页面里改过后以 data/live-settings.json 为准
MAX_TRADE_BNB=0.5

# 旧功能：买入后无限额预授权，不建议打开
PREAPPROVE=0

# 私有节点（可选，推荐）：例如 NodeReal 的 https://bsc-mainnet.nodereal.io/v1/<你的key>。填了就作为主节点（读链、查确认、扫 Four 事件，一次可查约 5 万块），
# 公共节点自动做备用。key 只放 .env，不要写进代码或提交
NODEREAL_RPC=
# 也可以填多个 NodeReal key（逗号分隔，只填 key 本身），会轮流使用；某个被限流 / 额度用完时自动换下一个，都不可用时用公共节点
NODEREAL_KEYS=

# 读链 RPC（不填 = 有 NODEREAL_RPC 用它，否则 bsc-dataseed）；扫 Four 事件用的 RPC；启动时回扫的区块数
RPC_URL=
FOUR_LOG_RPC=
FOUR_BACKFILL_BLOCKS=150000

# 币安 Agentic Wallet CLI
BAW_BIN=baw
BINANCE_CHAIN_ID=56
BAW_SLIPPAGE_UNIT=percent
WALLET_LABEL=币安 Agentic 钱包

# Four 专属模板的技能脚本路径（留空会自动在 .agents/ 和 ~/.claude/skills/ 里找）
OPENFOUR_SCRIPT=

# Feast（feast.meme）：引荐人地址（可选）。填了以后每笔 Feast 买卖都带上它：这笔 1% 手续费里的引荐份额（发币人定，默认成交额的 0.1%）链上记到这个地址，
# 钱包第一次带引荐人成交会终身绑定；留空 = 不带。FEAST_SITE / FEAST_API 一般不用改
FEAST_REFERRER=

# 其他可选项（一般不用改）
# 解析 .ai 域名用的 RPC，逗号分隔
NAME_RPC=
# 模拟 / 测试网用的 BSC 测试网 RPC
BSC_TESTNET_RPC=
# scripts/watch-four.js：WebSocket 节点、four.meme TokenManager 合约地址
BSC_WSS=
FOUR_MANAGER=

# 本地 API 防护
# 改动类接口（下单、设置、单币规则等）只接受本页面（同源）或带 x-tmtn-token 的请求。
# 留空会在 data/api-token 里随机生成；多钱包时每个钱包后端要填同一个值（或在 WALLET_PEERS 里给每个钱包写 token）
TMTN_API_TOKEN=
# 额外允许的主机名 / 页面来源（逗号分隔，一般不用填）
ALLOWED_HOSTS=
ALLOWED_ORIGINS=
# 代币头像代理额外允许的图床域名（逗号分隔；默认只允许 four.meme / pinata / gang.fun / IPFS 网关等）
IMG_HOSTS=

# 历史数据缓存（可选，不填就不启用，和以前一样）：MySQL 存各盘从开盘起的成交、外盘分钟 K 线、BNB 小时价、钱包交易记录，
# 重启或再次点开同一个币只补新的；Redis 存外部接口的短时结果，几个钱包后端共用。连不上会自动走原来的路径。
# 一键起这两个服务：docker compose -f docker/cache-compose.yml up -d（见 docs/cache.md）
MYSQL_URL=
REDIS_URL=
