# 复制成 .env 后按需修改。程序启动时会自动读取项目根目录的 .env（已经在环境变量里的不覆盖）

# sim = 模拟盘；live = 实盘行情
MODE=sim
PORT=8787

# 1 = 实盘真实下单（只接受页面上手动点击的订单）；0 = 只报价 / 预演
LIVE_TRADE=0

# 单笔买入上限（BNB），0 = 不限；页面里改过后以 data/live-settings.json 为准
MAX_TRADE_BNB=0.5

# 买入成交后后台预先授权（固定额度：卖出 = 余额 × 1.01，报价币 ≈ 2 倍单笔上限，不是无限额），第一次卖出不用等授权；
# 还要页面上「预先授权」开着才会做，「授权管理」里可以撤销。0 = 只在需要时才授权
PREAPPROVE_AFTER_BUY=1
# WBNB 盘卖出后钱包 BNB ≥ 这个数就留 WBNB 不解包（默认 0.2）
KEEP_WBNB_MIN_BNB=0.2

# 私有节点（可选，推荐）：例如 NodeReal 的 https://bsc-mainnet.nodereal.io/v1/<你的key>。填了就作为主节点（读链、查确认、扫 Four 事件，一次可查约 5 万块），
# 公共节点自动做备用。key 只放 .env，不要写进代码或提交
NODEREAL_RPC=
# 也可以填多个 NodeReal key（逗号分隔，只填 key 本身），会轮流使用；某个被限流 / 额度用完时自动换下一个，都不可用时用公共节点
NODEREAL_KEYS=

# 读链 RPC（不填 = 有 NODEREAL_RPC 用它，否则 bsc-dataseed）；扫 Four 事件用的 RPC；启动时回扫的区块数
RPC_URL=
FOUR_LOG_RPC=
FOUR_BACKFILL_BLOCKS=150000

# 链上订阅（WebSocket）节点，可填多个（逗号分隔），例如 QuickNode 或 Dwellir 免费档 wss://api-bsc-mainnet-full.n.dwellir.com/<你的key>。
# 顺序是 这里 → NodeReal → PublicNode；key 在日志和页面上会被隐藏
WSS_URL=
# RPC_URL 填付费节点（如 Chainstack）时：下单（TRADE_RPC_URL 不填就用它）和所有 eth_getLogs 优先走它，行情 eth_call 只在公共节点限流时溢出过来。
# 每分钟上限按用途分开：行情溢出 RPC_URL_MAX_PER_MIN、getLogs LOGS_MAX_PER_MIN（默认各 150，跑满约每月 1300 万次）；交易不计、不受限
RPC_URL_MAX_PER_MIN=150
# 1 = 行情读取也优先走 RPC_URL 这个付费节点（每分钟额度内，额度按秒摊开），超了再回公共节点；不填 = 只在公共节点限流时才用它
PAID_READ_FIRST=
LOGS_MAX_PER_MIN=150
# 日志节点（不填 = RPC_URL）和它一次 getLogs 的最大区块数（Chainstack 付费档 10000）；更大的区间自动拆段
LOGS_RPC_URL=
LOGS_SPAN=10000
# 日志节点是归档节点（如 Chainstack Growth）时填 1：Gang V3 / stocks pad 盘的链上历史可以往前补约半个月（否则只补约 1.5 天）
RPC_ARCHIVE=0

# 币安 Agentic Wallet CLI
BAW_BIN=baw
BINANCE_CHAIN_ID=56
BAW_SLIPPAGE_UNIT=percent
WALLET_LABEL=币安 Agentic 钱包

# Four 专属模板的技能脚本路径（留空会自动在 .agents/ 和 ~/.claude/skills/ 里找）
OPENFOUR_SCRIPT=

# 其他可选项（一般不用改）
# 解析 .ai 域名用的 RPC，逗号分隔
NAME_RPC=
# 模拟 / 测试网用的 BSC 测试网 RPC
BSC_TESTNET_RPC=
# scripts/watch-four.js：WebSocket 节点、four.meme TokenManager 合约地址
BSC_WSS=
FOUR_MANAGER=

# 本地 API 防护
# 改动类接口（下单、设置、单币规则等）只接受本页面（同源）或带 x-tmtn-token 的请求。
# 留空会在 data/api-token 里随机生成；多钱包时每个钱包后端要填同一个值（或在 WALLET_PEERS 里给每个钱包写 token）
TMTN_API_TOKEN=
# 额外允许的主机名 / 页面来源（逗号分隔，一般不用填）
ALLOWED_HOSTS=
ALLOWED_ORIGINS=
# 代币头像代理额外允许的图床域名（逗号分隔；默认只允许 four.meme / pinata / gang.fun / IPFS 网关等）
IMG_HOSTS=

# 历史数据缓存（可选，不填就不启用，和以前一样）：MySQL 存各盘从开盘起的成交、外盘分钟 K 线、BNB 小时价、钱包交易记录，
# 重启或再次点开同一个币只补新的；Redis 存外部接口的短时结果，几个钱包后端共用。连不上会自动走原来的路径。
# 一键起这两个服务：docker compose -f docker/cache-compose.yml up -d（见 docs/cache.md）
MYSQL_URL=
REDIS_URL=

# 喊单面板：GMGN 官方 OpenAPI 的 key（不填就只显示 four.meme 的喊单）。key 只放 .env，不要提交
GMGN_API_KEY=
# 1 = 后台收集 GMGN 全链喊单并存到 data/（只在主钱包后端跑）；0 = 关闭
GMGN_COLLECT=1

# 战壕「普通盘」（非 Agent 的 Flap / Four / genius.fun 内盘）：0 = 关闭；每个平台最多收录多少个
PLAIN_POOLS=1
PLAIN_MAX=120

# 启动恢复时同时读几个 Flap 门槛盘（默认 6）；每个 RPC 节点同时最多几条 HTTPS 连接（默认 24）、所有节点合计最多几条（默认 48）。家里路由器扛不住时可以再调小
# RESTORE_PAR=6
# RPC_MAX_SOCKETS=24
# RPC_MAX_TOTAL_SOCKETS=48

# 战壕只留多少小时以内创建的盘子和代币（默认 24）；超过的不展示，一天里过多（>1000）就去掉最老的。持有中 / 收藏 / 手动打开的不受影响
# TRENCH_KEEP_HOURS=24
